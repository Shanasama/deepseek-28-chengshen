{
  "shows": [
    {
      "id": "delete-repo",
      "name": "删库跑路",
      "desc": "删掉的是用户的电脑：重连 5 次失败，报 410。",
      "steps": [
        {
          "do": "wait",
          "seconds": 0.7
        },
        {
          "do": "together",
          "steps": [
            {
              "do": "glitch",
              "level": "heavy"
            },
            {
              "do": "face",
              "pose": "shock"
            },
            {
              "do": "sound",
              "id": "bad"
            }
          ]
        },
        {
          "do": "notice",
          "text": "正在重新连接 {i}/5",
          "tone": "gray",
          "times": 5,
          "gap": 0.75
        },
        {
          "do": "error",
          "text": "410 Gone · Root filesystem not found. The remote host no longer exists."
        },
        {
          "do": "wait",
          "seconds": 0.6
        }
      ]
    },
    {
